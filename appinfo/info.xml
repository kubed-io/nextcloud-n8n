  <dependencies>
    <!-- Not 30 or 31. AutoSyncSettings implements IDeclarativeSettingsFormWithHandlers
         (@since 31.0.0), which is the only way an ADMIN declarative form can carry a
         CHECKBOX at all — core's INTERNAL storage throws a TypeError on both the read
         and the write of a bool (see that class's docblock). That ruled out 30, which
         reached end of life in 2025 anyway. The floor is 32 rather than 31 because 31
         was never once executed by the integration suite: supporting it was a claim,
         and 32 is the oldest version the suite actually proves. -->
    <nextcloud min-version="32" max-version="34"/>
  </dependencies>
  <repair-steps>
    <!--
      Installs the application/n8n+json mimetype + icon mapping on every
      install/upgrade. Idempotent; see lib/Migration/RegisterMimetype.php.
    -->
    <install>
      <step>OCA\N8nSync\Migration\RegisterMimetype</step>
    </install>
    <post-migration>
      <step>OCA\N8nSync\Migration\RegisterMimetype</step>
      <!-- Rewrites any legacy-shaped folder mappings once on upgrade. Idempotent;
           see lib/Migration/MigrateMappings.php + MappingService::migrate(). -->
      <step>OCA\N8nSync\Migration\MigrateMappings</step>
      <!-- Deletes the retired n8n:sync/n8n:link/n8n:unmapped/n8n:ignore pills once.
           Without it a leftover pill would become an ordinary content tag and be
           pushed to n8n. Idempotent; see lib/Migration/RemoveModePills.php. -->
      <step>OCA\N8nSync\Migration\RemoveModePills</step>
      <!-- Renames already-synced `*.n8n.json` files to `*.n8n`. Runs AFTER
           RegisterMimetype so the renamed files land on a mimetype that exists.
           Without it an upgraded instance's workflows go unrecognised. Kept for a
           version or two — this app is published, so its population is not ours to
           count; see lib/Migration/MigrateFileExtension.php. -->
      <step>OCA\N8nSync\Migration\MigrateFileExtension</step>
      <!-- Deletes the retired webhook settings, one of which is an encrypted
           secret SECURITY.md no longer claims to hold, plus the api_enabled
           switch. Idempotent; see lib/Migration/RemoveWebhookSettings.php. -->
      <step>OCA\N8nSync\Migration\RemoveWebhookSettings</step>
    </post-migration>
    <uninstall>
      <!-- Mirror image of RegisterMimetype: reverts the core-tree mimetype/icon
           registration so removing the app leaves Nextcloud clean (store rule).
           Touches only the system registration — never user files/metadata/n8n.
           See lib/Migration/UnregisterMimetype.php + uninstall.feature. -->
      <step>OCA\N8nSync\Migration\UnregisterMimetype</step>
    </uninstall>
  </repair-steps>
