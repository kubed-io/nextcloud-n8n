  <dependencies>
    <!-- 31, not 30: AutoSyncSettings implements IDeclarativeSettingsFormWithHandlers
         (@since 31.0.0), which is the only way an ADMIN declarative form can carry a
         CHECKBOX at all — core's INTERNAL storage throws a TypeError on both the read
         and the write of a bool (see that class's docblock). Nextcloud 30 reached end
         of life in 2025, so nothing supported is lost. -->
    <nextcloud min-version="32" max-version="34"/>
  </dependencies>
  <settings>
    <!-- Test Connection buttons are folded into the Sync Actions panel
         (SyncSettings); AdminTest stays as the auth target for the test
         endpoints but is no longer rendered as its own panel. -->
    <admin>OCA\N8nSync\Settings\MappingSettings</admin>
    <admin>OCA\N8nSync\Settings\SyncSettings</admin>
    <admin-section>OCA\N8nSync\Settings\AdminSection</admin-section>
  </settings>
  <commands>
    <command>OCA\N8nSync\Command\ListWorkflows</command>
