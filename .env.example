# Integration stack config — copy to .env, then `tests/integration/stack.sh up`.
# These same canonical values are mirrored into the CI services in
# .github/workflows/integration.yml (CI does not read this file; keep in sync).

# --- Nextcloud (autoinstall on first boot) ---
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=admin

# --- n8n instance owner (pre-provisioned via env so there is no setup wizard) ---
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_FIRST_NAME=Test
N8N_OWNER_LAST_NAME=Owner

# N8N_INSTANCE_OWNER_PASSWORD_HASH must be a BCRYPT hash of the owner password,
# NOT plaintext (saga §4a.1). Generate one with:
#   php -r 'echo password_hash("n8npassword", PASSWORD_BCRYPT), PHP_EOL;'
# or:
#   htpasswd -bnBC 12 "" n8npassword | tr -d ':\n' | sed 's/$2y/$2a/'
# The hash below is for the password "n8npassword" — regenerate for anything real.
N8N_OWNER_PASSWORD_HASH=$2y$12$M/JhYL51spvMK3uMO8iraOSbWKqIkLldhcaA8Y2TzPAhZVQdV0Tju

# Note: the n8n public API key has NO headless mint (saga §4a.1). The minimal
# scaffolding test does not need it; pull/writeback tests added later will mint
# one by logging in with the owner creds above over REST.
