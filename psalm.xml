<psalm
	errorLevel="6"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="false"
	findUnusedCode="false"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	errorBaseline="tests/psalm-baseline.xml">
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<!--
		Load the nextcloud/ocp class definitions so Psalm resolves OCP\* symbols
		(IConfig, Files\Node, AppFramework\Controller, the Settings interfaces, …).
		Without this, Psalm reports every OCP reference as UndefinedClass /
		MissingDependency / UndefinedDocblockClass — ~176 false positives. We scan
		only the OCP package (not all of vendor) to keep analysis fast.
	-->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp" />
	</extraFiles>
</psalm>
