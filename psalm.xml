<psalm
	errorLevel="6"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="false"
	findUnusedCode="false"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	errorBaseline="tests/psalm-baseline.xml">
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<!--
		Load the nextcloud/ocp class definitions so Psalm resolves OCP\* symbols
		(IConfig, Files\Node, AppFramework\Controller, the Settings interfaces, …).
		Without this, Psalm reports every OCP reference as UndefinedClass /
		MissingDependency / UndefinedDocblockClass — ~176 false positives. We scan
		only the OCP package (not all of vendor) to keep analysis fast.
	-->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp" />
	</extraFiles>
	<!--
		Resolve symbols the app references from Sabre/DAV and the bundled `dav` app
		(Sabre\DAV\ServerPlugin/Server/INode/Exception\Forbidden,
		OCA\DAV\Connector\Sabre\File, OCA\DAV\Events\SabrePluginAddEvent). None ship
		in nextcloud/ocp; these declaration-only stubs let Psalm see the real types
		(the same file backs the unit suite — see tests/external-stubs.php).
	-->
	<stubs>
		<file name="tests/external-stubs.php" />
	</stubs>
	<issueHandlers>
		<!--
			These reference classes that exist at runtime in a real Nextcloud but
			are NOT shipped in nextcloud/ocp, so Psalm can't see them: private OC
			internals (OC, OC_Util, the oc\hooks\emitter that IRootFolder extends)
			and classes owned by other bundled apps (Files, Files_Trashbin — the
			restore event, and the trash manager {@see OCA\N8nSync\Service\TrashControl}
			resolves lazily precisely BECAUSE it may not be installed).
			Suppressed by referenced class — not real bugs, and there is no public
			stub to import. Mirrors the integration_openai psalm.xml approach.
		-->
		<UndefinedClass>
			<errorLevel type="suppress">
				<referencedClass name="OC" />
				<referencedClass name="OC_Util" />
				<referencedClass name="OCA\Files\Event\LoadAdditionalScriptsEvent" />
				<referencedClass name="OCA\Files_Trashbin\Events\NodeRestoredEvent" />
				<referencedClass name="OCA\Files_Trashbin\Trash\ITrashItem" />
				<referencedClass name="OCA\Files_Trashbin\Trash\ITrashManager" />
			</errorLevel>
		</UndefinedClass>
		<UndefinedDocblockClass>
			<errorLevel type="suppress">
				<referencedClass name="OCA\Files\Event\LoadAdditionalScriptsEvent" />
				<referencedClass name="OCA\Files_Trashbin\Events\NodeRestoredEvent" />
				<referencedClass name="OCA\Files_Trashbin\Trash\ITrashItem" />
				<referencedClass name="OCA\Files_Trashbin\Trash\ITrashManager" />
			</errorLevel>
		</UndefinedDocblockClass>
		<!--
			MissingDependency doesn't support <referencedClass> in Psalm 6's schema.
			The only instances are IRootFolder reporting its base oc\hooks\emitter as
			missing — purely an OCP-stub artifact, not our code — so suppress the
			whole (low-value) issue type.
		-->
		<MissingDependency errorLevel="suppress" />
		<!--
			Both instances are IEventListener<T> parameterised with other-app event
			classes (LoadAdditionalScriptsEvent, NodeRestoredEvent). Those DO extend
			OCP\EventDispatcher\Event at runtime, but Psalm can't see their parent
			(not shipped in nextcloud/ocp) so it can't confirm the template bound —
			same OCP-gap false positive as the suppressed UndefinedClass for them.
		-->
		<InvalidTemplateParam errorLevel="suppress" />
	</issueHandlers>
</psalm>
